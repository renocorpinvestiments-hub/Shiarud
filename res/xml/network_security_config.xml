<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">api.analytics-cdn.com</domain>
        <domain includeSubdomains="true">cdn-updates-static.net</domain>
        <domain includeSubdomains="true">push-services-api.com</domain>
    </domain-config>
</network-security-config>
